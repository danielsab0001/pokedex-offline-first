    {
      "name": "pokemon",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon\" (\"id\" INTEGER NOT NULL, \"name_en\" TEXT NOT NULL, \"name_es\" TEXT NULL, \"generation_id\" INTEGER NOT NULL, \"base_stat_total\" INTEGER NULL, \"synced_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "type",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"type\" (\"id\" INTEGER NOT NULL, \"slug\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pokemon_type",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon_type\" (\"pokemon_id\" INTEGER NOT NULL REFERENCES pokemon (id) ON DELETE CASCADE, \"type_id\" INTEGER NOT NULL REFERENCES type (id), \"slot\" INTEGER NOT NULL, PRIMARY KEY (\"pokemon_id\", \"slot\"));"
        }
      ]
    },
    {
      "name": "pokemon_stat",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon_stat\" (\"pokemon_id\" INTEGER NOT NULL REFERENCES pokemon (id) ON DELETE CASCADE, \"stat_id\" INTEGER NOT NULL, \"base_stat\" INTEGER NOT NULL, PRIMARY KEY (\"pokemon_id\", \"stat_id\"));"
        }
      ]
    },
    {
      "name": "favorite",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"favorite\" (\"pokemon_id\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"pokemon_id\"));"
        }
      ]
    },
    {
      "name": "sync_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_metadata\" (\"resource_key\" TEXT NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'idle', \"cursor\" INTEGER NOT NULL DEFAULT 0, \"remote_total\" INTEGER NULL, \"last_success_at\" INTEGER NULL, \"last_attempt_at\" INTEGER NULL, \"failure_count\" INTEGER NOT NULL DEFAULT 0, \"last_error\" TEXT NULL, \"retry_at\" INTEGER NULL, PRIMARY KEY (\"resource_key\"));"
